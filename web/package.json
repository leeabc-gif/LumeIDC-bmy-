{
  "name": "lumeidc-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-icons.mjs && vite",
    "build": "node scripts/build-icons.mjs && vue-tsc --noEmit && vite build --emptyOutDir",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check:responsive": "node scripts/responsive-check.mjs",
    "smoke": "node scripts/smoke-customer.mjs && node scripts/smoke-admin.mjs && node scripts/smoke-flows.mjs",
    "smoke:order": "node scripts/smoke-order.mjs",
    "smoke:service": "node scripts/smoke-service.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-json/ri": "^1.2.0",
    "@iconify/vue": "^5.0.0",
    "@novnc/novnc": "^1.7.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vueuse/core": "^13.9.0",
    "echarts": "^6.1.0",
    "element-plus": "~2.11.2",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "ohash": "^2.0.11",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.3.0",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.0",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/vaadin": "^1.2.1",
    "@types/node": "^24.0.5",
    "@types/nprogress": "^0.2.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^25.0.0",
    "puppeteer-core": "^25.11.0",
    "sass": "^1.81.0",
    "typescript": "~5.6.3",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-element-plus": "^0.10.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "~2.1.6"
  }
}
